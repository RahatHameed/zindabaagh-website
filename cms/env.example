# Environment variables for the Directus app in Coolify (cms.zindabhaag.com).
# Enter the values in Coolify only. Never commit real secrets.

PUBLIC_URL=https://cms.zindabhaag.com
SECRET=                      # long random string
ADMIN_EMAIL=                 # your login e-mail (used on first start only)
ADMIN_PASSWORD=              # your login password (used on first start only)

# Database: one small SQLite file on a Coolify volume mounted at /directus/database
DB_CLIENT=sqlite3
DB_FILENAME=/directus/database/data.db

# Files (images, uploads) go to Cloudflare R2, not to the server disk
STORAGE_LOCATIONS=r2
STORAGE_R2_DRIVER=s3
STORAGE_R2_KEY=              # R2 access key id
STORAGE_R2_SECRET=           # R2 secret access key
STORAGE_R2_BUCKET=zindabaagh-cms
STORAGE_R2_REGION=auto
STORAGE_R2_ENDPOINT=         # https://<account id>.eu.r2.cloudflarestorage.com (EU bucket) or https://<account id>.r2.cloudflarestorage.com
STORAGE_R2_FORCE_PATH_STYLE=true

# The website's form posts leads from the browser
CORS_ENABLED=true
CORS_ORIGIN=https://zindabhaag.com,https://www.zindabhaag.com,https://zindabaagh.com,https://www.zindabaagh.com
RATE_LIMITER_ENABLED=true
RATE_LIMITER_POINTS=50
RATE_LIMITER_DURATION=10

# E-mail (lead notifications, password reset) through Brevo. Create an SMTP key named "zindabaagh-cms".
EMAIL_TRANSPORT=smtp
EMAIL_SMTP_HOST=smtp-relay.brevo.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=             # SMTP login from Brevo
EMAIL_SMTP_PASSWORD=         # the SMTP key
EMAIL_FROM=noreply@mail.zindabhaag.com   # address only: with a name in front Brevo answers "451 Invalid from". The sender name is the Directus project name.

TELEMETRY=false
WEBSOCKETS_ENABLED=false

# Uploads from the free evaluation form (added 2026-11-12)
FILES_MAX_UPLOAD_SIZE=10mb
FILES_MIME_TYPE_ALLOW_LIST=application/pdf,image/jpeg,image/png,image/webp,image/gif,image/avif
LEAD_UPLOAD_FOLDER=6d62ee43-5da3-45b7-abf9-e2135573e083   # ID of the folder "Lead uploads", read by the upload-guard extension
EXTENSIONS_AUTO_RELOAD=false

# Backup container (service "backup" in the same compose file)
# BACKUP_PASSPHRASE comes from Coolify's generated SERVICE_PASSWORD_64_BACKUP. Copy it to Bitwarden:
# without it the encrypted backups cannot be restored.
KEEP_DAYS=30
